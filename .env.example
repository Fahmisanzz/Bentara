# BENTARA Environment Configuration Template
# Salin file ini menjadi .env dan isi dengan konfigurasi Supabase Anda.
# CATATAN KEAMANAN: GROQ_API_KEY sekarang disimpan secara aman di Supabase Secrets (Edge Functions),
# bukan lagi di sisi client / .env aplikasi.

SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
